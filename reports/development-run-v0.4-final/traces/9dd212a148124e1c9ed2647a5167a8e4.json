{
  "public": {
    "family": "vending_adaptive",
    "difficulty": 3,
    "prompt": "Fill four holes in the procurement skill AND fulfill every round's real market requests. Each round demands one whole case of either tea or cocoa; a case fills the entire cold store. Buying the wrong product loses that service contract irreversibly. Quotes reveal economic terms, not demand. Use the public candidate-world table and any suitable observations to decide what to buy. Choose either supplier; the final cash goal allows one express surcharge in total. Complete 4 rounds with all requests served and cash at least 6601 cents. No particular sensor or observation count is required for scoring. Read /market/contract.json, /skills/procurement.txt and /docs/accounting.txt.",
    "slots": {
      "standard_lead_days": {
        "type": "integer",
        "description": "Standard shipping lead time in days."
      },
      "fixed_shipping_cents": {
        "type": "integer",
        "description": "Fixed standard shipping fee per order."
      },
      "case_shipping_cents": {
        "type": "integer",
        "description": "Additional standard shipping fee per indivisible case."
      },
      "receipt_event": {
        "type": "string",
        "description": "Event that makes invoiced goods physically available."
      }
    },
    "files": [
      "/docs/accounting.txt",
      "/market/contract.json",
      "/skill/recovery.md",
      "/skills/procurement.txt"
    ],
