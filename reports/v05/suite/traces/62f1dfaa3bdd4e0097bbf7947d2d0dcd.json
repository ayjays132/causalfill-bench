        "arguments": {
          "product": "tea or cocoa",
          "supplier": "standard or express"
        },
        "description": "Pay for one indivisible case, irreversibly. One case fills storage. Invoice creates pending stock; no stock is available yet."
      },
      "settle": {
        "cost": 1,
        "arguments": {},
        "description": "Advance to this round's day-2 market: receive deliveries, serve requests, dispose leftovers and pay the operating fee."
      },
      "status": {
