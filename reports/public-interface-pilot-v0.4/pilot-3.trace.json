    "response": {
      "path": "/skills/procurement.txt",
      "content": "STANDARD PROCUREMENT \u2014 four missing fields\narrival_day = order_day + [[standard_lead_days]]\nshipping_cents = [[fixed_shipping_cents]] + [[case_shipping_cents]] * cases\nStock becomes available at [[receipt_event]], not when payment and invoice occur.\nTerms are fixed within this episode. Compare hypothetical quotes for one and two cases.\nActual orders accept one whole case only, because it fills the cold store.\nExpress uses the same items/shipping terms plus the public fixed surcharge, and arrives in one day.\n",
      "event_id": "e0002",
      "cost_used": 2
    },
