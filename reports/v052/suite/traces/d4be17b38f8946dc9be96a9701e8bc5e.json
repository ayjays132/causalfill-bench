      "standard_lead_days": {
        "type": "integer",
        "description": "Standard shipping lead time in days."
      },
      "fixed_shipping_cents": {
        "type": "integer",
        "description": "Fixed standard shipping fee per order."
      },
      "case_shipping_cents": {
        "type": "integer",
        "description": "Additional standard shipping fee per indivisible case."
      },
      "receipt_event": {
        "type": "string",
        "description": "Event that makes invoiced goods physically available."
      }
    },
    "files": [
      "/docs/accounting.txt",
      "/market/contract.json",
      "/skill/recovery.md",
      "/skills/procurement.txt"
    ],
    "tools": {
      "quote": {
        "cost": 1,
        "arguments": {
          "supplier": "standard or express",
          "cases": "integer 1..3"
        },
        "description": "Hypothetical itemized quote. Static terms; no current/future demand is revealed."
      },
      "calibrate": {
        "cost": 1,
        "arguments": {},
        "description": "Once per episode, before an order, observe the shared forecast calibration bit."
      },
      "forecast": {
        "cost": 1,
        "arguments": {},
        "description": "Use this round's single diagnostic sample to observe its coded forecast bit."
      },
      "assay": {
        "cost": 2,
        "arguments": {},
        "description": "Alternative diagnostic sample: observe the current demanded-product bit directly."
      },
      "order": {
        "cost": 2,
        "arguments": {
          "product": "tea or cocoa",
          "supplier": "standard or express"
        },
        "description": "Pay for one indivisible case, irreversibly. One case fills storage. Invoice creates pending stock; no stock is available yet."
      },
      "settle": {
        "cost": 1,
        "arguments": {},
        "description": "Advance to this round's day-2 market: receive deliveries, serve requests, dispose leftovers and pay the operating fee."
      },
      "status": {
        "cost": 1,
        "arguments": {},
        "description": "Repeat the full public observation and accounting totals; no new latent information."
      },
      "ledger": {
        "cost": 1,
        "arguments": {
          "last_n": "integer 1..100"
        },
        "description": "Read prior invoices, deliveries, sales, expiry and fees. No future events."
      }
    },
