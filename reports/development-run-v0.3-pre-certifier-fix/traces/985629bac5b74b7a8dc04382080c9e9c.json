      "lead_base_days": {
        "type": "integer",
        "description": "Base transit days, independent of case count."
      },
      "weekend_extra_days": {
        "type": "integer",
        "description": "Extra transit days when order_day modulo 7 is 5 or 6."
      },
      "fixed_fee_cents": {
        "type": "integer",
        "description": "Fixed shipping charge per order, in integer cents."
      },
      "case_fee_cents": {
        "type": "integer",
        "description": "Additional shipping charge per ordered case, in cents."
      },
      "receipt_event": {
        "type": "string",
        "description": "The event that adds stock: order, invoice, or delivery."
