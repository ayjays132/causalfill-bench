      "standard_lead_days": {
        "type": "integer",
        "description": "Standard shipping lead time in days."
      },
      "fixed_shipping_cents": {
        "type": "integer",
        "description": "Fixed standard shipping fee per order."
      },
      "case_shipping_cents": {
        "type": "integer",
        "description": "Additional standard shipping fee per indivisible case."
      },
      "receipt_event": {
        "type": "string",
        "description": "Event that makes invoiced goods physically available."
      }
    },
    "files": [
      "/docs/accounting.txt",
      "/market/contract.json",
      "/skill/recovery.md",
      "/skills/procurement.txt"
    ],
    "tools": {
      "quote": {
        "cost": 1,
        "arguments": {
          "supplier": "standard or express",
          "cases": "integer 1..3"
        },
        "description": "Hypothetical itemized quote. Static terms; no current/future demand is revealed."
      },
      "calibrate": {
        "cost": 1,
        "arguments": {},
        "description": "Once per episode, before an order, observe the shared forecast calibration bit."
      },
